{
  "name": "tickit",
  "productName": "Tickit",
  "version": "1.0.0",
  "description": "Tickit - Simple, Pure, React 19 & Zustand Reminder App",
  "main": "dist-electron/main/main.js",
  "author": "soprue",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/soprue/vanilla-reminder.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder",
    "generate:icon-types": "ts-node --esm scripts/generate-icon-types.ts"
  },
  "build": {
    "appId": "com.tickit.app",
    "productName": "Tickit",
    "copyright": "Copyright © 2024 soprue",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/assets/**/*",
      "preload.cjs"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg",
      "icon": "src/assets/logo.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "src/assets/logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "soprue",
        "repo": "vanilla-reminder"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^41.0.0",
    "electron-builder": "^25.1.8",
    "electron-reload": "^2.0.0-alpha.1",
    "esbuild": "^0.28.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.8",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-svgr": "^5.2.0"
  },
  "type": "module",
  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.1",
    "zustand": "^5.0.12"
  }
}
